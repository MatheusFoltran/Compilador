program TesteCompleto;

var x, y, z: integer;
    resultado, flag: boolean;
    contador_global: integer;

// Este comentário DEVE gerar erro (linha única)

procedure calcular(a, b: integer);
var temp: integer;
begin
    temp := a + b * 2;
    if temp > 100 then
        write(temp)
    else
        temp := temp - 10
end;

/* Este comentário de bloco
   DEVE gerar erro
   em múltiplas linhas */

function fatorial(n: integer): integer;
var i, fat: integer;
begin
    fat := 1;
    i := 1;
    while i <= n do
    begin
        fat := fat * i;
        i := i + 1
    end;
    fatorial := fat
end;

# Este comentário com hash DEVE gerar erro

{ Este comentário com chaves DEVE gerar erro }

(* Este comentário Pascal DEVE gerar erro *)

begin
    x := 0;
    y := 42;
    z := -15;
    
    // Outro comentário ilegal aqui
    
    read(x);
    
    if x < 0 then
        x := 0
    else if x > 100 then
        x := 100;
    
    resultado := (x >= 10) and (x <= 50);
    flag := true or false;
    flag := not flag;
    
    y := x + y - z * 2;
    z := y div 10;
    
    if x <> y then
        write(x)
    else
        write(y);
    
    contador_global := 0;
    while contador_global < 5 do
    begin
        write(contador_global);
        contador_global := contador_global + 1
    end;
    
    z := fatorial(5);
    calcular(10, 20);
    
    @ // Caractere inválido
    $ // Outro caractere inválido
    
    write(z)
end.